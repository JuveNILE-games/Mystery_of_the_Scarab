/* Main Menu Container */
.menu-container {
    width: 35%;
    height: 100%;
    justify-content: center;
    padding-left: 5%;
    padding-right: 5%;
    background-color: var(--bg-panel);
}

/* Base Menu Button */
.menu-button {
    margin-bottom: var(--spacing-xl);
    padding: var(--spacing-md) var(--spacing-xl);
    background-color: transparent;
    border-width: 0;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    flex-direction: row;
    align-items: center;
}

/* Button Text */
.menu-button > .unity-text-element {
    font-size: var(--font-size-icon); /* 32px approx or use larger manually if needed/defined */
    color: var(--text-color-muted);
    -unity-font-style: bold;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
    transition-duration: 0.2s;
}

/* Hover State */
.menu-button:hover {
    scale: 1.05;
}

.menu-button:hover > .unity-text-element {
    color: var(--color-primary);
    text-shadow: 0 0 10px var(--color-primary-hover);
}

/* Selected State (e.g. Start Game) */
.menu-button--selected {
    opacity: 1;
}

.menu-button--selected > .unity-text-element {
    color: var(--text-color-default);
    text-shadow: 0 0 15px var(--text-color-default);
}

/* Icon (if used) */
.menu-button__icon {
    width: 32px;
    height: 32px;
    margin-right: var(--spacing-lg);
    display: none; /* Hidden by default */
    background-color: var(--color-primary); 
    -unity-background-image-tint-color: var(--color-primary);
}

.menu-button--selected .menu-button__icon {
    display: flex;
}
