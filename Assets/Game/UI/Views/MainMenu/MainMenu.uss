/* Main Menu Container */
.menu-container {
    width: 35%;
    height: 100%;
    justify-content: center;
    padding-left: 5%;
    padding-right: 5%;
    background-color: rgba(0, 0, 0, 0.4); /* Subtle dark overlay */
}

/* Base Menu Button */
.menu-button {
    margin-bottom: 20px;
    padding: 15px 20px;
    background-color: transparent;
    border-width: 0;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    flex-direction: row;
    align-items: center;
}

/* Button Text */
.menu-button > .unity-text-element {
    font-size: 32px;
    color: rgb(200, 200, 200); /* Off-white */
    -unity-font-style: bold;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
    transition-duration: 0.2s;
}

/* Hover State */
.menu-button:hover {
    scale: 1.05;
}

.menu-button:hover > .unity-text-element {
    color: rgb(255, 215, 0); /* Gold */
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
}

/* Selected State (e.g. Start Game) */
.menu-button--selected {
    opacity: 1;
}

.menu-button--selected > .unity-text-element {
    color: rgb(255, 255, 255);
    text-shadow: 0 0 15px rgba(255, 255, 255, 0.8);
}

/* Icon (if used) */
.menu-button__icon {
    width: 32px;
    height: 32px;
    margin-right: 15px;
    display: none; /* Hidden by default */
    background-color: rgb(255, 215, 0); /* Fallback color if no sprite */
}

.menu-button--selected .menu-button__icon {
    display: flex;
}
